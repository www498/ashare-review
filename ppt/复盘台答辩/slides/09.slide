<Slide style={{ background: '#FFFFFF', padding: '60px', flexDirection: 'column' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>自选股：每只票的当日解释</Text>
    <Box style={{ width: 1160, height: 1, background: '#D9DEE6', marginTop: 12 }} />

    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 18 }}>
        <Image src="assets/watch.png" style={{ width: 860, height: 417, objectFit: 'cover', borderRadius: 6, border: '1px solid #E5E9F0' }} />
        <Box style={{ width: 276, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'column', borderTop: '2px solid #1E3A5F', paddingTop: 10 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E3A5F' }}>不是行情列表</Text>
                <Text style={{ fontSize: 18, color: '#3F4A55', lineHeight: 1.75, marginTop: 4 }}>
                    每只票都能展开：为什么涨、分时、诊断。
                </Text>
            </Box>
            <Box style={{ flexDirection: 'column', borderTop: '2px solid #1E3A5F', paddingTop: 10, marginTop: 14 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E3A5F' }}>赤峰黄金 +10.0%</Text>
                <Text style={{ fontSize: 18, color: '#3F4A55', lineHeight: 1.75, marginTop: 4 }}>
                    涨停、量比 1.16，三段归因拆到板块与个股。
                </Text>
            </Box>
            <Box style={{ flexDirection: 'column', borderTop: '2px solid #B08D57', paddingTop: 10, marginTop: 14 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E3A5F' }}>未来 5 日区间</Text>
                <Text style={{ fontSize: 18, color: '#3F4A55', lineHeight: 1.75, marginTop: 4 }}>
                    30.54 ~ 39.98，覆盖 80.5%、R² 0.06 —— 只当包络。
                </Text>
            </Box>
        </Box>
    </Box>
</Slide>
