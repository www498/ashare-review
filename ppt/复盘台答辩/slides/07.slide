<Slide style={{ background: '#FFFFFF', padding: '60px', flexDirection: 'column' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>每一手，都有一个 0–100 的合理性</Text>
    <Box style={{ width: 1160, height: 1, background: '#D9DEE6', marginTop: 12 }} />

    <Image src="assets/journal.png" style={{ width: 1160, height: 350, objectFit: 'cover', borderRadius: 6, border: '1px solid #E5E9F0', marginTop: 16 }} />

    <Box style={{ flexDirection: 'row', alignItems: 'flex-end', marginTop: 16 }}>
        <Text style={{ fontSize: 18, color: '#64748B', marginRight: 18 }}>今天 11 手的中位</Text>
        <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#B08D57', letterSpacing: -2, lineHeight: 1 }}>50</Text>
        <Text style={{ fontSize: 22, color: '#64748B', marginBottom: 8, marginLeft: 8 }}>/ 100</Text>
        <Text style={{ fontSize: 18, color: '#3F4A55', lineHeight: 1.7, marginLeft: 28 }}>
            位置层 45%：当日分位、量能、持有天数　·　时点层 55%：成交前 30 分钟、日内位置<br />
            同一页里从 26 到 65 —— 赤峰涨停追入 26，紫金高位兑现 65。
        </Text>
    </Box>

    <Box style={{ width: 1160, height: 52, background: '#F4F6F9', borderRadius: 8, paddingLeft: 22, flexDirection: 'row', alignItems: 'center', marginTop: 14 }}>
        <Text style={{ fontSize: 18, color: '#1A1A1A' }}>时点层只用成交前的分时，之后的走势不参与评分。</Text>
    </Box>
</Slide>
